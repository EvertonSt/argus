# ---------------------------------------------------------------------------
# Argus configuration
# Copy to `.env` and fill in. NEVER commit a real .env — it is gitignored.
#
# You do NOT need any of this to try Argus:  `npm run run:mock`  works with
# zero API key and zero cost.
# ---------------------------------------------------------------------------

# Required for live (non --mock) runs. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model name is config, never hardcoded — swap it without touching code.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Default target when `--target` is omitted. The bundled demo app.
ARGUS_TARGET_URL=http://localhost:4317

# CI fails the build only when a real_bug is filed at or above this severity.
# One of: critical | high | medium | low
ARGUS_SEVERITY_FAIL_THRESHOLD=high

# Hard cap on Anthropic API calls per run. Keeps cost predictable.
ARGUS_MAX_AI_CALLS=25

# Reported in filed bug reports' environment string.
ARGUS_BROWSER=Chromium (Playwright)
