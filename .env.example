# ---------------------------------------------------------------------------
# Argus configuration
# Copy to `.env` and fill in. NEVER commit a real .env — it is gitignored.
#
# You do NOT need any of this to try Argus:  `npm run run:mock`  works with
# zero API key and zero cost.
# ---------------------------------------------------------------------------

# Required for live (non --mock) runs. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model name is config, never hardcoded — swap it without touching code.
ARGUS_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Default target when `--target` is omitted. The bundled demo app.
ARGUS_TARGET=http://localhost:4317

# CI fails the build only when a real_bug is filed at or above this severity.
# One of: critical | high | medium | low
ARGUS_CI_THRESHOLD=high

# Hard cap on Anthropic API calls per run. Keeps cost predictable.
ARGUS_MAX_AI_CALLS=25

# Reported in filed bug reports' environment string.
ARGUS_BROWSER=Chromium (Playwright)

# ---- AI Provider Configuration ----
# Provider: claude (default) | openai | openrouter | deepseek | groq | together | ollama | mock
ARGUS_AI_PROVIDER=claude

# For openai-compatible providers (includes OpenRouter, Groq, DeepSeek, etc.)
ARGUS_OPENAI_BASE_URL=https://api.openai.com/v1
ARGUS_OPENAI_API_KEY_ENV=OPENAI_API_KEY    # which env var holds the key
ARGUS_OPENAI_MODEL=gpt-4o                   # model name for openai-compatible

# For local Ollama (offline, no key needed):
# ARGUS_AI_PROVIDER=ollama
# ARGUS_OPENAI_BASE_URL=http://localhost:11434/v1
# ARGUS_OPENAI_MODEL=llama3.1:latest
