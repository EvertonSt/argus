      "routes": [
        "/stats"
      ],
      "keySelectors": [
        "[data-testid=\"nav-tasks\"]",
        "[data-testid=\"nav-stats\"]",
        "[data-testid=\"nav-about\"]"
      ]
    },
    {
      "id": "about-page",
      "name": "About",
      "description": "The /about screen. It contains a link \"Tasks\" to /, a link \"Stats\" to /stats, a link \"About\" to /about.",
      "routes": [
        "/about"
      ],
      "keySelectors": [
        "[data-testid=\"nav-tasks\"]",
